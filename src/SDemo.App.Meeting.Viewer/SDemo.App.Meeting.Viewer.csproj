<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- 结果页外壳：WPF + BlazorWebView（组件在进程内跑，不起 HTTP 服务）。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SDemo.App.Meeting.Viewer</RootNamespace>
    <AssemblyName>SDemo.Meeting.Viewer</AssemblyName>
    <Product>会议</Product>
    <AssemblyTitle>会议</AssemblyTitle>
    <Description>会议 · 转写结果</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.App.Meeting.Contracts\SDemo.App.Meeting.Contracts.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Storage\SDemo.App.Meeting.Storage.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Core\SDemo.App.Meeting.Core.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Asr\SDemo.App.Meeting.Asr.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Web\SDemo.App.Meeting.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebView 的内容根是 AppContext.BaseDirectory，wwwroot 必须显式复制到输出。 -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
