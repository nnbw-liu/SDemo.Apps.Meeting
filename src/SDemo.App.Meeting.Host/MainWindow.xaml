<Window x:Class="SDemo.App.Meeting.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:web="clr-namespace:SDemo.App.Meeting.Web;assembly=SDemo.App.Meeting.Web"
        Title="会议 · 转写结果"
        Width="1180" Height="760"
        MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0a0c11">

    <blazor:BlazorWebView x:Name="Web" HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type web:MeetingResult}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

</Window>
