<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- 组合根：WPF 外壳 + BlazorWebView + 进程内 MCP。带命令行参数时走 CLI，供脚本/CI 用。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SDemo.App.Meeting.Host</RootNamespace>
    <AssemblyName>SDemo.Meeting</AssemblyName>
    <Product>会议</Product>
    <AssemblyTitle>会议</AssemblyTitle>
    <Description>会议 · 录音、转写、议题与决议</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.App.Meeting.Contracts\SDemo.App.Meeting.Contracts.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Storage\SDemo.App.Meeting.Storage.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Core\SDemo.App.Meeting.Core.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Asr\SDemo.App.Meeting.Asr.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Audio\SDemo.App.Meeting.Audio.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Mcp\SDemo.App.Meeting.Mcp.csproj" />
    <ProjectReference Include="..\SDemo.App.Meeting.Web\SDemo.App.Meeting.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebView 的内容根是 AppContext.BaseDirectory，wwwroot 必须显式复制到输出。 -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
